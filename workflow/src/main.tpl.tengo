wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
maps := import("@platforma-sdk/workflow-tengo:maps")
render := import("@platforma-sdk/workflow-tengo:render")
json := import("json")

rarefactionTpl := assets.importTemplate(":rarefaction-calculation")

getSpec := func(abundanceSpec, args) {
	return {
		axes: [
			{
				column: "pl7_app_sampleId",
				spec: abundanceSpec.axesSpec[0]
			},
			{
				column: "subsampling_depth",
				spec: {
					name: "pl7.app/rarefaction/depth",
					type: "Int",
					domain: maps.merge(
						abundanceSpec.domain,
						{
							"pl7.app/rarefaction/numPoints": args.numPoints,
							"pl7.app/rarefaction/numIterations": args.numIterations
						}
					),
					annotations: {
						"pl7.app/label": "Rarefaction depth"
					}
				}
			}
		],
		columns: [
			{
				column: "mean_unique_clonotypes",
				spec: {
					name: "pl7.app/rarefaction/meanUniqueSequences",
					valueType: "Double",
					domain: maps.merge(
						abundanceSpec.domain,
						{
							"pl7.app/rarefaction/numPoints": args.numPoints,
							"pl7.app/rarefaction/numIterations": args.numIterations
						}
					),
					annotations: {
						"pl7.app/label": "Mean unique sequences",
						"pl7.app/format": ".2f"
					}
				}
			},
			{
				column: "type",
				spec: {
					name: "pl7.app/rarefaction/type",
					valueType: "String",
					domain: maps.merge(
						abundanceSpec.domain,
						{
							"pl7.app/rarefaction/numPoints": args.numPoints,
							"pl7.app/rarefaction/numIterations": args.numIterations
						}
					),
					annotations: {
						"pl7.app/label": "Type"
					}
				}
			}
		],
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

wf.prepare(func(args) {
	bundleBuilder := wf.createPBundleBuilder()
	bundleBuilder.ignoreMissingDomains() // to make query work for both bulk and single cell data
	bundleBuilder.addAnchor("main", args.datasetRef)

	bundleBuilder.addSingle({
		axes: [ { anchor: "main", idx: 0 }, { anchor: "main", idx: 1 }],
		annotations: {
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/normalized": "false",
				"pl7.app/abundance/isPrimary": "true"
			}
		},
		"abundance")

	// Optional subset column picked alongside the dataset (PlDatasetSelector)
	if !is_undefined(args.inputFilter) {
		bundleBuilder.addRef(json.decode(args.inputFilter))
	}

	return {
		columns: bundleBuilder.build()
    }
})

wf.body(func(args) {

	datasetSpec := args.columns.getSpec(args.datasetRef)
	convMem := string(args.mem) + "GiB"

	// Optional subset: only its clonotypes enter the curves. The trace roots in the filter so
	// labels name it.
	filterColumn := undefined
	traceSpec := datasetSpec
	if !is_undefined(args.inputFilter) {
		f := args.columns.getColumn(json.decode(args.inputFilter))
		filterColumn = { spec: f.spec, data: f.data }
		traceSpec = f.spec
	}

	tsv := undefined
	if is_undefined(filterColumn) {
		tsvBuilder := pframes.tsvFileBuilder()
		tsvBuilder.mem(convMem)
		tsvBuilder.cpu(1)
		tsvBuilder.add(args.columns.getColumn("abundance"), {header: "abundance"})
		tsvBuilder.setAxisHeader(datasetSpec.axesSpec[1].name, "sequenceKey")
		tsv = tsvBuilder.build()
	} else {
		// The table builder heads axes by their label: name the sample axis as the software expects.
		tb := pframes.tableBuilder("tsv")
		tb.mem(convMem)
		tb.cpu(1)
		tb.addPrimary("main", {
			__isPrimaryRef: "v1",
			column: args.columns.getColumn("abundance"),
			filter: filterColumn
		}, {header: "abundance"})
		tb.setAxisHeader(datasetSpec.axesSpec[0].name, "pl7_app_sampleId")
		tb.setAxisHeader(datasetSpec.axesSpec[1].name, "sequenceKey")
		tsv = tb.build()
	}

	// Call UMAP calculation subtemplate
	rarefactionRender := render.create(rarefactionTpl, {
		inputTsv: tsv,
		numPoints: args.numPoints,
		numIterations: args.numIterations,
		extrapolation: args.extrapolation,
		metaInputs: {
			mem: args.mem,
			cpu: args.cpu
		}
	})

    rarefactionPFrame := xsv.importFile(rarefactionRender.output("rarefactionOutput"), "tsv", getSpec(datasetSpec, args), {
		splitDataAndSpec: true
	})
    
    trace := pSpec.makeTrace(
        traceSpec,
        {
            type: "milaboratories.rarefaction",
            id: wf.blockId().getDataAsJson(),
            importance: 50,
            label: "Rarefaction"
        }
    )

    tracedPFrame := pframes.pFrameBuilder()
    for colId, col in rarefactionPFrame {
        tracedPFrame.add(colId, trace.inject(col.spec), col.data)
    }
	tracedPFrame = tracedPFrame.build()

	return {
		outputs: {
			rarefactionPFrame: pframes.exportFrame(tracedPFrame),
			rarefactionLogs: rarefactionRender.output("rarefactionLogs"),
			noData: rarefactionRender.output("noData")
		},
		exports: {}
	}
})